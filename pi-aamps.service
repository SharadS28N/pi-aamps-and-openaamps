[Unit]
Description=pi-aamps — Pi Advanced Audio & Music Player System
After=network.target sound.target bluetooth.target

[Service]
Type=simple
User=aamps
WorkingDirectory=/home/aamps/pi-aamps-and-openaamps
ExecStart=/home/aamps/pi-aamps-and-openaamps/venv/bin/python /home/aamps/pi-aamps-and-openaamps/run.py
Restart=always

RestartSec=3
Environment=PORT=8000
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

